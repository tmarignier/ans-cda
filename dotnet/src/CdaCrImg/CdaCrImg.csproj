<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 : consommable depuis .NET Framework 4.6.1+ et .NET Core/.NET 5+. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>CdaCrImg</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Paquet NuGet -->
    <PackageId>CdaCrImg</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>tmarignier</Authors>
    <PackageTags>cda;hl7;ci-sis;ans;imagerie;compte-rendu;ins;dmp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/tmarignier/ans-cda</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tmarignier/ans-cda</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- SourceLink (intégré au SDK .NET) et paquet de symboles -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Description>Production d'un compte rendu d'imagerie médicale au format HL7 CDA R2 non structuré (niveau 1, PDF encapsulé), en-tête conforme au volet CI-SIS IMG-CR-IMG 2024.01.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

